{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GuetLinker",
  "version": "2.3.3",
  "identifier": "com.guetlinker.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GuetLinker",
        "width": 640,
        "height": 820,
        "minWidth": 640,
        "minHeight": 820,
        "maxWidth": 640,
        "maxHeight": 820,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
